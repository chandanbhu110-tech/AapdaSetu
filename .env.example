# SIH NER Smart Logistics Platform Environment Configuration
# Copy this file to .env.local and add your real API keys / Supabase project credentials.
# The application will run seamlessly in resilient DEMO DATA MODE if keys are not provided.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_key
VITE_OPENWEATHER_API_KEY=your_openweather_api_key
